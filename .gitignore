build
__pycache__/
*.pyc

# LaTeX build intermediates (the PDFs themselves are checked-in deliverables)
documentation/*.aux
documentation/*.lof
documentation/*.log
documentation/*.lot
documentation/*.out
documentation/*.toc
documentation/*_body.html

# Embedded Amiga binaries — test-only, auto-processed by build_iso.sh
