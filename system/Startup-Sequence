; Ultimate Amiga OS — Startup-Sequence
; Phase 2: Explicit startup-script initialisation.
;
; Phase 1 (ROM fallback) has already been performed by the kernel when the
; boot volume was identified:
;   SYS:        -> boot volume root (Workbench:)
;   LIBS:       -> SYS:Libs      (Workbench:Libs)
;   C:          -> SYS:C         (Workbench:C)
;   S:          -> SYS:S         (Workbench:S)
;   DEVS:       -> SYS:Devs      (Workbench:Devs)
;   L:          -> SYS:L         (Workbench:L)
;   Tools:      -> SYS:Tools     (Workbench:Tools)
;   Utilities:  -> SYS:Utilities (Workbench:Utilities, deferred)
;   Classes:    -> SYS:Classes   (Workbench:Classes, deferred)
;   FONTS:      -> SYS:Fonts     (Workbench:Fonts, deferred)
;
; This script now refines and extends those fallback assigns, exactly as
; AmigaDOS does after Kickstart hooks up the pre-assigns.

C:Version >NIL:

; RAM-based transient assigns
Assign >NIL: ENV: RAM:ENV
Assign >NIL: T: RAM:T
Assign >NIL: Clips: RAM:Clipboards
Assign >NIL: REXX: SYS:REXX

; Device sub-directory assigns
Assign >NIL: PRINTERS: DEVS:Printers
Assign >NIL: KEYMAPS: DEVS:Keymaps

; System directory assigns
Assign >NIL: REXXC: S:REXXc

; GNU POSIX compatibility layer — gnu: maps to Workbench:gnu
; Contains /usr/bin, /bin, /usr/local/bin with GNU coreutils and
; other OSS tools that take GNU-style flags.
Assign >NIL: gnu: Workbench:gnu

; ACE Basic compiler — ACE: points to the compiler installation
Assign >NIL: ACE: SYS:ACE
Assign >NIL: ACElib: ACE:lib
Assign >NIL: ACEbmaps: ACE:bmaps
Assign >NIL: ACEinclude: ACE:include
Assign >NIL: ACEsubmods: ACE:submods

; Extend LIBS: with additional class directories (searched after SYS:Libs)
Assign >NIL: LIBS: SYS:Classes ADD

; Optional assigns — deferred so missing targets do not fail boot
Assign >NIL: HELP: LOCALE:Help DEFER
Assign >NIL: LOCALE: SYS:Locale DEFER

SetEnv Language "english"
SetEnv Workbench $Workbench
SetEnv Kickstart $Kickstart
UnSet Workbench
UnSet Kickstart

; Start network stack
;echo "Starting network..."
C:NetStart >NIL:

; Start NTP background sync
;echo "Starting NTP sync..."
run >NIL: C:ntpd

; Welcome message
;echo "Ultimate Amiga OS - Live Workbench Environment"
;echo ""


; Execute user-defined startup commands if present
IF EXISTS S:User-Startup
  execute S:User-Startup
ENDIF

; ACE Basic tests are in S:User-Startup so they run with the scheduler
; active (Wait(SIGF_CHILD) requires a parent task context).

; Load Workbench desktop
echo ""
echo "Starting Workbench..."
C:LoadWB
