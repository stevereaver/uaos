// pointer.gui — Pointer Prefs layout (UAOS-127)
//
// Loaded by PointerPrefs_Show via uibind_load_gui(): this file under
// SYS:Prefs/GUI/ is the shipped layout; ENV:GUI/pointer.gui overrides it
// at runtime.  Node ids are numeric and must match the enum in
// kernel/display/pointer_prefs.c (1..3 = size, 4..5 = double-pixel,
// 6..10 = acceleration, 11 = Apply, 12 = Close).

window "Pointer Prefs" {
    vgroup {
        label "Cursor Size:" ;
        hgroup {
            button "16x16" id=1 weight=1 ;
            button "32x32" id=2 weight=1 ;
            button "48x48" id=3 weight=1 ;
        }
        label "Double Pixel:" ;
        hgroup {
            button "Off" id=4 weight=1 ;
            button "On"  id=5 weight=1 ;
        }
        label "Acceleration:" ;
        hgroup {
            button "0%"   id=6  weight=1 ;
            button "25%"  id=7  weight=1 ;
            button "50%"  id=8  weight=1 ;
            button "75%"  id=9  weight=1 ;
            button "100%" id=10 weight=1 ;
        }
        spacer ;
        hgroup {
            spacer ;
            button "Apply" id=11 min=96,0 ;
            button "Close" id=12 min=96,0 ;
            spacer ;
        }
    }
}
